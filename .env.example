# Copy to .env and fill in. .env is gitignored.

# Public hostname that GitHub delivers webhooks to. Caddy gets the TLS cert for it.
FORKKEEPER_DOMAIN=forkkeeper.example.com

# Address the private API binds to on the host. Keep it on localhost or a VPN address.
API_BIND=127.0.0.1

FORKKEEPER_VERSION=dev
FORKKEEPER_LOG_LEVEL=info

# GitHub App identifiers (not secret). The private key and webhook secret go in ./secrets/.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
