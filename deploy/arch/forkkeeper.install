post_install() {
  cat <<'MSG'
==> Fork Keeper is installed but not started. To set it up:
    1. Edit /etc/forkkeeper/config.yaml (repos, auth, notifications).
    2. Store secrets, encrypted with the TPM2 where there is one:
         forkkeeperctl set-credential github_pat
         forkkeeperctl set-credential github_webhook_secret
    3. Check it:  forkkeeperctl check
    4. Start it:  systemctl enable --now forkkeeper
MSG
}

post_upgrade() {
  echo '==> Restart Fork Keeper to run the new version: systemctl restart forkkeeper'
}
