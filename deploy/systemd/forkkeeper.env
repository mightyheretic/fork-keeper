# Local settings for forkkeeper.service, read after the unit's defaults.
# Secrets don't belong here: use forkkeeperctl set-credential.

# Listen addresses. The webhook receiver is public through your reverse
# proxy; the private API must never be exposed (localhost, Tailscale or
# WireGuard addresses only).
#FORKKEEPER_WEBHOOK_ADDR=127.0.0.1:8080
#FORKKEEPER_API_ADDR=127.0.0.1:8081

#FORKKEEPER_LOG_LEVEL=info

# Referenced from config.yaml as ${GITHUB_APP_ID} (not a secret).
#GITHUB_APP_ID=
